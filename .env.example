# Copy this file to ".env" only if you want to run the app on your own computer.
# On Vercel you add these in Project > Settings > Environment Variables instead.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
# Server-only key (used by /api/admin-users to create teacher logins). Never share it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
